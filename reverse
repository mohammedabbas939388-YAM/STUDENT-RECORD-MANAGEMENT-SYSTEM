#include"student.h"
int count(std *p)
{
        int c=0;
        while(p)
        {
                c++;
                p=p->next;
        }
        return c;
}
void rev_list(std **ptr)
{
        if(*ptr==0)
        {
                printf("No records found\n");
                return;
        }
        int i,c=count(*ptr);
        std **a,*t=*ptr;
        if(c>1)
        {
                a=malloc(sizeof(std *)*c);
                for(i=0;i<c;i++)
                {
                        a[i]=t;
                        t=t->next;
                }
                for(i=c-1;i>0;i--)
                        a[i]->next=a[i-1];
                a[0]->next=0;
                *ptr=a[c-1];
        }

}
